{
  "name": "Zixi Documentation Generator",
  "version": "1.0.0",
  "description": "Generates documentation for the Zixi IO-style robot template without adding any extra functionality to main.",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build-frontend": "tsc --project assets/javadoc/scripts/tsconfig.json",
    "patch": "npm run build-frontend && tsx scripts/JavadocPatcher.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuypulse/zixi.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/stuypulse/zixi/issues"
  },
  "homepage": "https://github.com/stuypulse/zixi#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vercel/node": "^29.0.1",
    "highlight.js": "^11.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
