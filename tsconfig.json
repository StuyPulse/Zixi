{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["api/**/*.ts", "scripts/**/*.ts"],
  "exclude": [
    "node_modules",
    "assets/javadoc/scripts/**/*"
  ]
}
